# ============================================
# INNOVAR SECURITY - Variables de Entorno
# ============================================
# Copia este archivo a .env.local y configura

# --- DESARROLLO ---
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GENERAR-CON: openssl rand -base64 32"
SESSION_MAX_AGE="7"

# --- PAGOS ---
PAYMENT_PROVIDER="test"
WEBHOOK_SECRET=""

# --- ALMACENAMIENTO ---
# Opciones: local | s3 | cloudinary
STORAGE_PROVIDER="local"
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# --- EMAIL ---
# Opciones: console | resend | sendgrid
EMAIL_PROVIDER="console"
# EMAIL_FROM="noreply@innovarsecurity.com"
# RESEND_API_KEY=""
# SENDGRID_API_KEY=""

# --- WHATSAPP (pendiente) ---
# WHATSAPP_API_URL=""
# WHATSAPP_TOKEN=""

# --- STAGING ---
# Usar con: NODE_ENV=production DATABASE_URL="postgresql://..."
# NEXTAUTH_URL="https://staging.tudominio.com"
# NEXTAUTH_SECRET="[generar-con-openssl-rand-base64-32]"
# WEBHOOK_SECRET="[generar-con-openssl-rand-base64-32]"

# --- PRODUCCIÓN (configurar al desplegar) ---
# NODE_ENV="production"
# DATABASE_URL="postgresql://..."
# NEXTAUTH_URL="https://tudominio.com"
# NEXTAUTH_SECRET="[generar-con-openssl]"
# WEBHOOK_SECRET="[generar-con-openssl]"
# PAYMENT_PROVIDER="real"
# EMAIL_PROVIDER="resend"
# STORAGE_PROVIDER="s3"
